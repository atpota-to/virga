# Copy to worker/.env (not committed) and fill in.
VIRGA_URL=https://virga.example
# The same value as on Vercel: openssl rand -hex 32
DEFENSE_WORKER_SECRET=
# How often to call the list writer, in seconds (at least 15).
WORKER_INTERVAL_SECONDS=60

# The moderator: the Bluesky account owners DM, and an app password for it
# made with "Allow access to your direct messages" ticked. Unset, the worker
# reads no DMs. Set DEFENSE_MODERATOR_HANDLE on Vercel too (only the handle),
# so Defense › Lists can say who to DM.
DEFENSE_MODERATOR_HANDLE=
DEFENSE_MODERATOR_PASSWORD=
# Where the moderator account signs in: its PDS or entryway. bsky.social by default.
DEFENSE_MODERATOR_SERVICE=
# How often to read its DMs, in seconds (at least 2).
WORKER_DM_SECONDS=5

# Sentences: the Vercel AI Gateway. Unset, the moderator answers typed
# commands only. The models must call tools.
AI_GATEWAY_API_KEY=
DEFENSE_AGENT_MODEL=deepseek/deepseek-v4.1-flash
# The write check's model; the agent's by default.
DEFENSE_CHECK_MODEL=
# 'on' routes only to providers with zero data retention.
DEFENSE_AGENT_ZDR=
