// Settings shared by every configuration. Copy Local.xcconfig.example to
// Local.xcconfig (not committed) to set your own team and server.

// Where Virga's server is: the web app's VITE_BACKEND_URL. The iOS app
// always signs in through it (a long session), and it runs scheduling,
// timers and the adviser. No trailing slash. `/` is escaped as `/$()/`
// because xcconfig reads `//` as a comment.
VIRGA_BACKEND_URL = https:/$()/virga.app
// The host of that server, for the associated domain the sign-in returns to.
VIRGA_HOST = virga.app

// The web app's VITE_DEFENSE and VITE_DEFENSE_MODERATOR: "on" shows them.
VIRGA_DEFENSE = off
VIRGA_DEFENSE_MODERATOR = off

VIRGA_BUNDLE_ID = app.virga.Virga
VIRGA_TEAM_ID =

// The app's App Store page, once it has one (https:/$()/apps.apple.com/app/
// id…). A build made before the Terms of Service or the Privacy Policy move
// on can't record an agreement to the new ones; the agreement screen then
// offers an Update button that opens this. Empty: it only says to update.
VIRGA_APP_STORE_URL =

#include? "Local.xcconfig"
