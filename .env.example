# Virga's environment, server and client.
#
# Copy to .env.local for `vercel dev`, or set these in the Vercel project
# (Settings → Environment Variables). Set the server secrets for the
# Production environment only: a preview deployment without them answers 503
# on every server route and the app keeps working in browser mode, whereas a
# preview with them would be a second OAuth client writing to production's
# database. Nothing here is read at import time, so a missing value turns a
# feature off rather than failing the deployment.
#
# Never commit real values. .env and .env*.local are git-ignored.


# ─── Client build flags (read by Vite when the app is built) ───────────────

# How new accounts sign in: `browser` (the app's own OAuth client, sessions
# live in the browser) or `backend` (Virga's server holds the session, which
# is what scheduling, timers and the adviser need). Default: browser.
VITE_AUTH_MODE=browser

# Where Virga's server is. Empty means the app's own origin (the functions
# under /api deployed alongside it). Set an origin, e.g.
# https://virga-git-main-you.vercel.app, only to point a local `npm run dev`
# at a deployed server; that server must then list the dev origin in
# OAUTH_EXTRA_RETURN_ORIGINS. Default: empty.
VITE_BACKEND_URL=


# ─── Supabase (required for every server feature) ──────────────────────────

# Virga's own Supabase project. Apply supabase/migrations first
# (`supabase db push`). Without both values, sign-in, scheduling and timers
# answer 503 and AI usage goes uncounted.
SUPABASE_URL=
# Service-role key (Project Settings → API). Bypasses RLS; server only.
# SUPABASE_SERVICE_KEY is accepted as an older name for the same thing.
SUPABASE_SERVICE_ROLE_KEY=


# ─── Long sessions: Virga's confidential OAuth client ──────────────────────

# Virga's production origin, e.g. https://virga.example.com (https; no path).
# The client_id is ${OAUTH_PUBLIC_URL}/api/oauth/client-metadata.json and every
# grant is bound to it, so never change it after the first sign-in. The
# metadata, JWKS and callback under /api/oauth/ must stay reachable without
# Vercel Deployment Protection. Required for backend sign-in.
OAUTH_PUBLIC_URL=

# ES256 private JWK (JSON, with a kid), from `node scripts/generate-oauth-key.js`.
# Without one every /api/oauth route answers 503 VIRGA_CLIENT_UNAVAILABLE.
# Required for backend sign-in.
OAUTH_PRIVATE_KEY_1=
# Rotation slots. Slot 1 is the key new sign-ins use; a session keeps signing
# its refreshes with the key it signed in with. To rotate, move the current key
# unchanged to slot 2 and put the new one in slot 1. Remove a retired key only
# once every account that signed in with it has signed in again. A key without
# a kid is named by its thumbprint. Optional.
OAUTH_PRIVATE_KEY_2=
OAUTH_PRIVATE_KEY_3=

# Sign-ins started per address per minute (/api/oauth/login). Default: 20.
OAUTH_LOGIN_RATE_LIMIT=

# How long an instance remembers that an account's grant is dead (refresh
# refused), so calls fail at once instead of retrying. Milliseconds. Default:
# 600000 (10 minutes); a fresh sign-in clears it.
OAUTH_DEAD_GRANT_TTL_MS=

# Extra exact origins a sign-in may return to (comma-separated; no wildcards),
# e.g. http://127.0.0.1:5173 for local development against a deployed server.
# These origins also get CORS answers. OAUTH_PUBLIC_URL's origin is always
# allowed. Optional.
OAUTH_EXTRA_RETURN_ORIGINS=

# 32-byte key, 64 hex characters or base64, for encrypting stored OAuth
# sessions (AES-256-GCM): `openssl rand -hex 32`. Treat as required in
# production; without it sessions are stored unencrypted.
SESSION_ENCRYPTION_KEY=

# Terms of service and privacy policy links on the consent screen. https only
# (anything else is dropped). Optional.
OAUTH_TOS_URL=
OAUTH_POLICY_URL=

# `true` skips the cross-instance token lock while an access token has more
# than five minutes left. Default: off.
OAUTH_LOCK_FAST_PATH=

# Per-instance cache lifetimes, in milliseconds. Default: 60000 each.
OAUTH_SESSION_CACHE_TTL_MS=
FRONTEND_SESSION_CACHE_TTL_MS=

# How long an image upload may take to reach the PDS, in milliseconds.
# Default: 12000.
UPLOAD_FORWARD_TIMEOUT_MS=


# ─── Crons ─────────────────────────────────────────────────────────────────

# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` to /api/schedule/run
# and /api/self-destruct/run every minute. Production refuses every run
# without it. On a Hobby plan the deployment itself fails: Vercel refuses a
# Hobby cron that runs more than once a day. There, remove the `crons` entries
# from vercel.json and call both paths every minute from another scheduler
# (pg_cron and pg_net, see the README) with this bearer. Required in
# production: `openssl rand -hex 32`.
CRON_SECRET=


# ─── Scheduling ────────────────────────────────────────────────────────────

# Most pending (and publishing) scheduled posts one account may hold.
# Default: 50.
SCHEDULE_MAX_PENDING=
# Creates per account per minute, per instance. Default: 30.
SCHEDULE_CREATE_PER_MIN=
# Scheduled posts the worker claims per tick. Default: 20.
SCHEDULE_CLAIM_LIMIT=
# A plan limit on scheduled posts, reported by /api/limits/status and enforced
# with 409 QUOTA_EXCEEDED. Unset: unlimited (up to SCHEDULE_MAX_PENDING).
SCHEDULED_POSTS_LIMIT=


# ─── Timers ────────────────────────────────────────────────────────────────

# Most live timers one account may hold. Default: 200.
TIMER_MAX_ACTIVE_PER_USER=
# Timers armed per account per minute, per instance. Default: 60.
SELF_DESTRUCT_CREATE_PER_MIN=
# Plan limits on plain and conditional timers, reported by /api/limits/status
# and enforced with 409 QUOTA_EXCEEDED. Unset: unlimited.
POST_TIMERS_LIMIT=
CONDITIONAL_TIMERS_LIMIT=
# Public AppView the timers read counts and threads from.
# Default: https://public.api.bsky.app
BSKY_APPVIEW_URL=
# PLC directory used to find a DID's PDS. Default: https://plc.directory
PLC_DIRECTORY_URL=


# ─── AI (the posting adviser and image descriptions) ───────────────────────

# Vercel AI Gateway key. Without it the /api/ai routes answer 503.
# Required for AI features.
AI_GATEWAY_API_KEY=
# Default: https://ai-gateway.vercel.sh/v1
AI_GATEWAY_BASE_URL=
# `false` stops tagging requests for the gateway's usage reporting (tag
# app:virga). Default: on.
AI_GATEWAY_REPORTING=

# Models, as gateway ids. A *_FALLBACKS list is comma-separated; `none` or an
# empty value means no fallback, unset inherits the kind-wide default.
# The adviser (analyze-post, synthesize-style). Default: AI_MODEL_DEFAULT.
AI_MODEL_POSTING_ADVISER=
AI_MODEL_POSTING_ADVISER_FALLBACKS=
# Image descriptions; must accept images. Default: AI_MODEL_VISION_DEFAULT.
AI_MODEL_ALT_TEXT=
AI_MODEL_ALT_TEXT_FALLBACKS=
# Kind-wide defaults for text and for vision models.
AI_MODEL_DEFAULT=
AI_MODEL_DEFAULT_FALLBACKS=
AI_MODEL_VISION_DEFAULT=
AI_MODEL_VISION_DEFAULT_FALLBACKS=

# Monthly allowances per account (UTC months): a number (0 switches the
# feature off) or `unlimited`. Defaults: 30 adviser reads, 3 style readings, 15 descriptions.
AI_ADVISER_MONTHLY_LIMIT=
AI_STYLE_MONTHLY_LIMIT=
AI_ALT_TEXT_MONTHLY_LIMIT=
# All AI calls per account per UTC day, a cost ceiling. Default: 200.
AI_DAILY_LIMIT=
# AI calls per account per minute, per instance. Default: 40.
AI_BURST_PER_MIN=


# ─── Set by Vercel (don't set these yourself) ──────────────────────────────
# VERCEL, VERCEL_ENV, VERCEL_URL. VERCEL_ENV=production (or NODE_ENV=production
# elsewhere) is what makes the crons refuse to run without CRON_SECRET.
